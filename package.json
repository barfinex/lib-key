{
  "name": "@barfinex/key",
  "version": "0.0.0-development",
  "private": false,
  "description": "Key management module for the Barfinex ecosystem. Provides initialization, secure storage, and retrieval of unique application identification keys using NestJS services.",
  "author": "Barfinex",
  "license": "MIT",
  "homepage": "https://github.com/barfinex/lib-key#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/barfinex/lib-key.git"
  },
  "bugs": {
    "url": "https://github.com/barfinex/lib-key/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.app.json",
    "rebuild": "npm run clean && npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "barfinex",
    "key",
    "keys",
    "key-management",
    "crypto",
    "security",
    "identification",
    "nestjs",
    "nestjs-module",
    "typescript",
    "persistence",
    "fs"
  ],
  "dependencies": {
    "@barfinex/types": "1.0.14",
    "@barfinex/utils": "1.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "rimraf": "^5.0.5",
    "semantic-release": "^24.1.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^20.11.30"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
